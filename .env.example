# Copy to .env.local for local development.
# Also add these in the Vercel project → Settings → Environment Variables.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only secret (Settings → API → service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional — defaults to anndrea-birthday
# COUPON_BOOK_ID=anndrea-birthday

# Optional — overrides config/site.ts resetPassword for API resets
# RESET_PASSWORD=Alexisthebest123

# Optional — Alex dashboard password (defaults to RESET_PASSWORD / site reset password)
# ALEX_PASSWORD=Alexisthebest123

# Optional — cookie signing secret for /alex sessions (defaults to service role key)
# ALEX_SESSION_SECRET=a-long-random-string

# Public site URL used in notification email links (e.g. https://your-app.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Web Push (phone lock-screen notifications) — required for real phone alerts
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# Optional contact for VAPID (mailto:...). Defaults to ALEX_NOTIFY_EMAIL.
# VAPID_SUBJECT=mailto:you@example.com

# Optional email alerts when a coupon is redeemed (Resend)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Coupon Book <onboarding@resend.dev>
# ALEX_NOTIFY_EMAIL=you@example.com
