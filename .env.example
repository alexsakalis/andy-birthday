# Copy to .env.local for local development.
# Also add these in the Vercel project → Settings → Environment Variables.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only secret (Settings → API → service_role). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional — defaults to anndrea-birthday
# COUPON_BOOK_ID=anndrea-birthday
